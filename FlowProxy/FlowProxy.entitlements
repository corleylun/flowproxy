<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Disable App Sandbox for local dev/debugging -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Network server: allows binding TCP listener sockets -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Network client: allows outbound connections -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Keychain access: store CA cert and keys -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.flowproxy.app</string>
	</array>
	<!-- Allow reading/writing to user-selected files -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Temporary exception for keychain trust settings (requires admin approval) -->
	<key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
	<array>
		<string>/Library/Keychains/</string>
	</array>
</dict>
</plist>
